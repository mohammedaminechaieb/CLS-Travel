# =============================================================
# CLS Travel — variables d'environnement
# Copier vers .env et remplir. NE JAMAIS committer le fichier .env
# =============================================================

# --- App ---
NODE_ENV=production
APP_URL=https://carthagoloisirs.com
API_URL=https://api.carthagoloisirs.com
# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGINS=https://carthagoloisirs.com,https://www.carthagoloisirs.com
API_PORT=4000

# --- Database ---
POSTGRES_USER=clsuser
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=cls_travel
DATABASE_URL=postgresql://clsuser:PASSWORD@postgres:5432/cls_travel

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_ACCESS_SECRET=<random-64-chars>
JWT_REFRESH_SECRET=<random-64-chars>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Domaine du cookie refresh (partagé entre www et api)
COOKIE_DOMAIN=.carthagoloisirs.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEPOSIT_PERCENT=30
# Devise de facturation Stripe (TND non supportée par Stripe → EUR par défaut)
STRIPE_CURRENCY=eur
# Taux de conversion TND → devise Stripe
STRIPE_TND_EXCHANGE_RATE=0.30

# --- SendGrid ---
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@carthagoloisirs.com
SENDGRID_FROM_NAME=CLS Travel

# --- OVHcloud Object Storage (S3-compatible) ---
OVH_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
OVH_S3_BUCKET=cls-travel-media
OVH_S3_ACCESS_KEY=...
OVH_S3_SECRET_KEY=...
OVH_S3_REGION=gra
OVH_S3_PUBLIC_URL=https://cls-travel-media.s3.gra.io.cloud.ovh.net
OVH_S3_BACKUP_BUCKET=cls-travel-backups

# --- Backups (pg_dump chiffré) ---
BACKUP_ENCRYPTION_PASSPHRASE=<random-64-chars>
BACKUP_RETENTION_DAYS=30

# --- Frontend (exposé au navigateur) ---
NEXT_PUBLIC_API_URL=https://api.carthagoloisirs.com
NEXT_PUBLIC_SITE_URL=https://carthagoloisirs.com
NEXT_PUBLIC_GMAPS_KEY=...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# URL interne utilisée par le serveur Next.js (SSR) pour joindre l'API
INTERNAL_API_URL=http://backend:4000

# --- Admin par défaut (seed) ---
ADMIN_EMAIL=admin@cls-travel.com
ADMIN_PASSWORD=<strong-password>

# --- Déploiement ---
GHCR_IMAGE_PREFIX=ghcr.io/<github-owner>/cls-travel
IMAGE_TAG=latest
CERTBOT_EMAIL=admin@carthagoloisirs.com
