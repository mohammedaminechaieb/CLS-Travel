// CLS Travel — schéma de données (PostgreSQL 16)
// Les noms de champs suivent la convention snake_case des colonnes SQL.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================= ENUMS =========================

enum Role {
  super_admin
  manager
  agent
  client
}

enum PackageCategory {
  circuit
  sejour
  excursion
  omra
  affaires
}

enum PackageStatus {
  draft
  published
  archived
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum PaymentType {
  deposit
  balance
  full
}

enum PostStatus {
  draft
  published
}

enum DiscountType {
  percent
  fixed
}

// ========================= MODELS =========================

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique
  password_hash      String? // bcrypt — null pour les comptes OAuth
  role               Role     @default(client)
  first_name         String
  last_name          String
  phone              String? // format E.164
  avatar_url         String?
  is_verified        Boolean  @default(false)
  refresh_token_hash String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)

  bookings          Booking[]      @relation("BookingClient")
  assigned_bookings Booking[]      @relation("BookingAgent")
  blog_posts        BlogPost[]
  messages          Message[]
  audit_logs        AuditLog[]
  notifications     Notification[]

  @@index([role])
  @@map("users")
}

model Destination {
  id          String  @id @default(uuid()) @db.Uuid
  name_fr     String
  name_ar     String
  name_en     String
  country     String
  region      String?
  cover_url   String?
  description String?

  packages Package[]

  @@index([country])
  @@map("destinations")
}

model Package {
  id             String          @id @default(uuid()) @db.Uuid
  slug           String          @unique
  title_fr       String
  title_ar       String
  title_en       String
  description_fr String
  description_ar String
  description_en String
  destination_id String          @db.Uuid
  category       PackageCategory
  duration_days  Int
  base_price     Decimal         @db.Decimal(10, 3) // TND
  max_capacity   Int
  gallery_urls   String[]
  itinerary      Json            @default("[]") // programme jour par jour
  included       String[]
  excluded       String[]
  status         PackageStatus   @default(draft)
  featured       Boolean         @default(false)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @updatedAt @db.Timestamptz(6)

  destination Destination @relation(fields: [destination_id], references: [id], onDelete: Restrict)
  bookings    Booking[]

  @@index([status, category])
  @@index([destination_id])
  @@index([featured])
  @@map("packages")
}

model Booking {
  id                String        @id @default(uuid()) @db.Uuid
  reference         String        @unique // CLS-YYYY-NNNNN
  user_id           String        @db.Uuid
  package_id        String        @db.Uuid
  departure_date    DateTime      @db.Date
  return_date       DateTime      @db.Date
  participants      Json // [{nom, prenom, passport, dob}]
  total_price       Decimal       @db.Decimal(10, 3)
  paid_amount       Decimal       @default(0) @db.Decimal(10, 3)
  discount_amount   Decimal       @default(0) @db.Decimal(10, 3)
  promo_code_id     String?       @db.Uuid
  status            BookingStatus @default(pending)
  assigned_agent_id String?       @db.Uuid
  notes_internal    String?
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @updatedAt @db.Timestamptz(6)

  user           User       @relation("BookingClient", fields: [user_id], references: [id], onDelete: Restrict)
  package        Package    @relation(fields: [package_id], references: [id], onDelete: Restrict)
  assigned_agent User?      @relation("BookingAgent", fields: [assigned_agent_id], references: [id], onDelete: SetNull)
  promo_code     PromoCode? @relation(fields: [promo_code_id], references: [id], onDelete: SetNull)
  payments       Payment[]
  reviews        Review[]
  messages       Message[]

  @@index([user_id])
  @@index([package_id])
  @@index([status])
  @@index([assigned_agent_id])
  @@index([created_at])
  @@map("bookings")
}

model Payment {
  id                       String        @id @default(uuid()) @db.Uuid
  booking_id               String        @db.Uuid
  stripe_payment_intent_id String        @unique
  amount                   Decimal       @db.Decimal(10, 3)
  currency                 String        @db.Char(3) // TND / EUR / USD
  status                   PaymentStatus @default(pending)
  payment_type             PaymentType
  paid_at                  DateTime?     @db.Timestamptz(6)
  created_at               DateTime      @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id])
  @@index([status, paid_at])
  @@map("payments")
}

model Review {
  id          String   @id @default(uuid()) @db.Uuid
  booking_id  String   @db.Uuid
  rating      Int // 1–5 (contrainte CHECK dans la migration)
  comment     String
  is_approved Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id])
  @@index([is_approved])
  @@map("reviews")
}

model BlogPost {
  id           String     @id @default(uuid()) @db.Uuid
  slug         String     @unique
  title_fr     String
  title_ar     String
  title_en     String
  body         Json // contenu Tiptap (ProseMirror JSON)
  excerpt_fr   String?
  excerpt_ar   String?
  excerpt_en   String?
  cover_url    String?
  author_id    String     @db.Uuid
  tags         String[]
  status       PostStatus @default(draft)
  published_at DateTime?  @db.Timestamptz(6)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @updatedAt @db.Timestamptz(6)

  author User @relation(fields: [author_id], references: [id], onDelete: Restrict)

  @@index([status, published_at])
  @@map("blog_posts")
}

model PromoCode {
  id                  String       @id @default(uuid()) @db.Uuid
  code                String       @unique
  discount_type       DiscountType
  value               Decimal      @db.Decimal(10, 3)
  expires_at          DateTime?    @db.Timestamptz(6)
  max_uses            Int?
  current_uses        Int          @default(0)
  is_active           Boolean      @default(true)
  applicable_packages String[] // tableau vide = tous les voyages

  bookings Booking[]

  @@map("promo_codes")
}

model Message {
  id         String   @id @default(uuid()) @db.Uuid
  booking_id String   @db.Uuid
  sender_id  String   @db.Uuid
  body       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([booking_id, created_at])
  @@map("messages")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actor_id      String   @db.Uuid
  action        String // ex. BOOKING_STATUS_CHANGED, USER_ROLE_UPDATED
  resource_type String
  resource_id   String?
  payload       Json?
  ip            String?
  user_agent    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  actor User @relation(fields: [actor_id], references: [id], onDelete: Restrict)

  @@index([actor_id])
  @@index([resource_type, resource_id])
  @@index([created_at])
  @@map("audit_logs")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  type       String // ex. BOOKING_CONFIRMED, PAYMENT_RECEIVED
  payload    Json
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
  @@map("notifications")
}

// ===================== TABLES TECHNIQUES =====================

/// Compteur annuel pour les références CLS-YYYY-NNNNN (incrément atomique).
model BookingSequence {
  year       Int @id
  last_value Int @default(0)

  @@map("booking_sequences")
}

/// Événements Stripe déjà traités — garantit l'idempotence du webhook.
model StripeEvent {
  id           String   @id // evt_...
  type         String
  processed_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("stripe_events")
}

/// Inscriptions à la newsletter (formulaire du pied de page).
model NewsletterSubscriber {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  locale     String   @default("fr")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("newsletter_subscribers")
}
