{
  "name": "cls-travel",
  "private": true,
  "version": "1.0.0",
  "description": "CLS Travel — plateforme agence de voyage carthagoloisirs.com",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cls/api --filter @cls/web dev",
    "build": "pnpm --filter @cls/shared build && pnpm --filter @cls/api build && pnpm --filter @cls/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:migrate": "pnpm --filter @cls/api prisma:migrate",
    "db:seed": "pnpm --filter @cls/api prisma:seed",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:prod": "docker compose up -d --build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "prettier": "^3.3.3"
  }
}
